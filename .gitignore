# Generated by scripts/generate-test-inventory.sh (contains the server IP)
ansible/*.ini

# Ansible
*.retry
.vault_pass
.vault_pass.txt
*.vault_password

# SSH keys and certificates
*.pem
*.key
id_rsa*

# Environment files (rendered .env should never be committed)
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Saved plans
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Local variables may contain secrets
*.tfvars
*.tfvars.json
